# CogniQuest Pattern Recognition Platform - Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/cogniquest

# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cogniquest?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-to-a-long-random-string

# Google Maps API (Optional - for food truck features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CORS Configuration (Optional)
# CLIENT_URL=http://localhost:3000

# Email Configuration (Optional - for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# File Upload (Optional)
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
# SESSION_SECRET=another-secret-key-for-sessions
# SESSION_TIMEOUT=86400000

# Feature Flags (Optional)
# ENABLE_SOCIAL_FEATURES=true
# ENABLE_LEADERBOARD=true
# ENABLE_ACHIEVEMENTS=true

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Payment Gateway (Optional - for premium subscriptions)
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
