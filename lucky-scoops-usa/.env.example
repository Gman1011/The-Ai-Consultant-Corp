# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# Stripe secret key (server-side only, never exposed to the browser)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe publishable key (safe for the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe webhook signing secret (for /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Fully-qualified site URL (used for Stripe redirect URLs and SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
